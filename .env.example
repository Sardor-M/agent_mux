# agent_mux local config. Copy to .env and adjust as needed:
#
#   cp .env.example .env
#
# Nothing here is required for local gateway use — with no .env, auth runs in
# allow-all dev mode and the gateway serves the demo MCP server. `make up` and
# the launchd agent both source .env if present.

# Comma-separated API keys required on /v1/agents and /mcp.
# Unset = allow-all (dev only). Set this before exposing the port to anyone.
# AGENT_MUX_API_KEYS=test-key

# MCP servers to supervise and expose through the gateway. Defaults to the
# in-repo demo manifest; point this at your own to expose your tools.
AGENT_MUX_MCP_FILE=examples/tools/mcp_servers.json

# Redis port for the background service.
# REDIS_PORT=6390

# Only needed for the /v1/agents loop against real Anthropic — the MCP
# gateway path needs no LLM key.
# ANTHROPIC_API_KEY=sk-ant-...
