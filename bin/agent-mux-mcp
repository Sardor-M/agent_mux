#!/usr/bin/env python3
"""agent-mux-mcp — stdio<->HTTP bridge to the agent_mux MCP gateway.

Lets stdio-only MCP clients (some Codex configs, older Claude Code setups)
talk to the agent_mux Streamable-HTTP `/mcp` endpoint. Reads newline-delimited
JSON-RPC from stdin, forwards each message to the gateway, and writes each
response to stdout. Notifications (no `id`) get no reply, matching MCP stdio.

Wire it into a client as a stdio server:

    { "mcpServers": { "mux": { "command": "/abs/path/bin/agent-mux-mcp" } } }

Config via env:
    AGENT_MUX_MCP_URL   gateway endpoint (default http://localhost:8080/mcp)
    AGENT_MUX_API_KEY   sent as X-API-Key if set
"""
import json
import os
import sys
import urllib.error
import urllib.request

URL = os.environ.get("AGENT_MUX_MCP_URL", "http://localhost:8080/mcp")
API_KEY = os.environ.get("AGENT_MUX_API_KEY")


def post(payload: bytes):
    req = urllib.request.Request(URL, data=payload, method="POST")
    req.add_header("Content-Type", "application/json")
    if API_KEY:
        req.add_header("X-API-Key", API_KEY)
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            return resp.status, resp.read()
    except urllib.error.HTTPError as e:
        return e.code, e.read()
    except Exception as e:  # noqa: BLE001 — surface any transport failure upstream
        return None, str(e).encode()


def write_line(obj) -> None:
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def is_jsonrpc_response(obj) -> bool:
    return isinstance(obj, dict) and obj.get("jsonrpc") == "2.0" and (
        "result" in obj or "error" in obj
    )


def error_replies(msg, msg_id, message):
    """Build a JSON-RPC error reply (or list of replies for a batch) tied to
    the original request id(s). Returns None if `msg` was a notification
    (nothing should be written back)."""
    if isinstance(msg, list):
        errs = [
            {"jsonrpc": "2.0", "id": m.get("id"),
             "error": {"code": -32000, "message": message}}
            for m in msg
            if isinstance(m, dict) and m.get("id") is not None
        ]
        return errs or None
    if msg_id is not None:
        return {"jsonrpc": "2.0", "id": msg_id,
                "error": {"code": -32000, "message": message}}
    return None


def main() -> None:
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            continue

        status, body = post(line.encode())
        msg_id = msg.get("id") if isinstance(msg, dict) else None

        if status is None:
            # Transport failure. Reply with a JSON-RPC error only if the
            # client expects a response (i.e. this was a request, not a
            # notification). For batch requests, return an error per item
            # that has an id.
            reply = error_replies(msg, msg_id, "gateway unreachable: " + body.decode(errors="replace"))
            if reply is not None:
                write_line(reply)
            continue

        if status == 202 or not body:
            # Notification accepted — nothing to write back.
            continue

        body_str = body.decode("utf-8", errors="replace")

        if status >= 400:
            # HTTP-level error (auth, size cap, parse error, upstream/proxy
            # failure). The body may be a JSON error object without
            # jsonrpc/id fields, or a plain-text proxy error — neither is a
            # valid MCP reply, so normalize it into a JSON-RPC error tied to
            # the original request id instead of passing it through.
            reply = error_replies(msg, msg_id, f"gateway error {status}: {body_str}")
            if reply is not None:
                write_line(reply)
            continue

        try:
            parsed = json.loads(body_str)
        except json.JSONDecodeError:
            parsed = None

        if parsed is None or not (isinstance(parsed, list) or is_jsonrpc_response(parsed)):
            # 2xx but not a well-formed JSON-RPC response/batch — don't dump
            # the raw body to stdout, normalize it instead.
            reply = error_replies(msg, msg_id, f"invalid gateway response: {body_str}")
            if reply is not None:
                write_line(reply)
            continue

        # Write the gateway response directly — it is a valid JSON-RPC reply.
        sys.stdout.write(body_str)
        if not body_str.endswith("\n"):
            sys.stdout.write("\n")
        sys.stdout.flush()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
